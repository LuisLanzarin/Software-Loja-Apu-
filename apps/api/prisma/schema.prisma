// Banco local SQLite.
// Convenções: dinheiro em CENTAVOS (Int) e quantidades em MILÉSIMOS (Int),
// para evitar erros de arredondamento. Percentuais em pontos-base (1% = 100).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum Perfil {
  VENDEDOR
  FINANCEIRO
  GERENTE
  ADMIN
}

model Usuario {
  id                Int       @id @default(autoincrement())
  nome              String
  login             String    @unique
  senhaHash         String
  perfil            Perfil
  ativo             Boolean   @default(true)
  trocarSenha       Boolean   @default(false)
  tentativasFalhas  Int       @default(0)
  bloqueadoAte      DateTime?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  sessoes   Sessao[]
  auditoria Auditoria[]
  historicoPrecos HistoricoPreco[]
  movimentacoes MovimentacaoEstoque[]
  entradas  Entrada[] @relation("EntradaCriadaPor")
  entradasCanceladas Entrada[] @relation("EntradaCanceladaPor")
  sessoesCaixa CaixaSessao[]
  movimentosCaixa CaixaMovimento[]
  vendas       Venda[] @relation("VendaVendedor")
  vendasAutorizadas Venda[] @relation("VendaAutorizadaPor")
  vendasCanceladas Venda[] @relation("VendaCanceladaPor")
  boletosBaixados ContaReceber[]
}

model Sessao {
  // Guardamos apenas o hash SHA-256 do token; o token em si só existe no cookie.
  id           String   @id
  usuarioId    Int
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadaEm     DateTime @default(now())
  ultimoAcesso DateTime @default(now())
  expiraEm     DateTime
  ip           String?
  userAgent    String?

  @@index([usuarioId])
}

model Configuracao {
  id                         Int      @id @default(1)
  nomeLoja                   String   @default("Minha Loja")
  // Desconto até este percentual (pontos-base) não precisa de autorização do gerente.
  descontoMaxSemAutorizacao  Int      @default(500)
  // Cancelamento de venda até este valor (centavos) não precisa de autorização.
  cancelamentoMaxSemAutorizacao Int   @default(10000)
  // Logout automático após X minutos sem uso.
  sessaoInatividadeMin       Int      @default(30)

  // Formação de preço (markup divisor), em pontos-base sobre o preço de venda.
  impostosPct                Int      @default(600)
  despesasFixasPct           Int      @default(1500)
  comissaoPct                Int      @default(0)
  margemPadraoPct            Int      @default(2000)

  // Orçamento vale por X dias (o preço do orçamento é respeitado até lá).
  validadeOrcamentoDias      Int      @default(7)
  atualizadoEm               DateTime @updatedAt
}

model Auditoria {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao       String
  entidade   String?
  entidadeId String?
  detalhes   String?  // JSON
  ip         String?
  criadoEm   DateTime @default(now())

  @@index([criadoEm])
  @@index([usuarioId])
}

// ---------------------------------------------------------------- Etapa 2

model Unidade {
  id          Int     @id @default(autoincrement())
  sigla       String  @unique
  nome        String
  // Aceita quantidade quebrada (2,5 m). "UN" e "PC" normalmente não.
  fracionavel Boolean @default(false)
  ativo       Boolean @default(true)

  produtos   Produto[]
  conversoes ProdutoConversao[]
  itensEntrada EntradaItem[]
}

model Categoria {
  id           Int     @id @default(autoincrement())
  nome         String  @unique
  // Margem desejada padrão para os produtos desta categoria (pontos-base). Nulo = usa a da loja.
  margemPct    Int?
  ativo        Boolean @default(true)

  produtos Produto[]
}

model Fornecedor {
  id               Int      @id @default(autoincrement())
  razaoSocial      String
  nomeFantasia     String?
  documento        String?  @unique // CNPJ ou CPF, só dígitos
  telefone         String?
  email            String?
  contato          String?
  cidade           String?
  uf               String?
  prazoEntregaDias Int?
  observacoes      String?
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  produtos ProdutoFornecedor[]
  entradas Entrada[]
}

model Produto {
  id             Int        @id @default(autoincrement())
  codigo         String     @unique
  codigoBarras   String?    @unique
  descricao      String
  // Descrição em minúsculas e sem acentos, usada na busca.
  descricaoBusca String
  marca          String?
  categoriaId    Int?
  categoria      Categoria? @relation(fields: [categoriaId], references: [id])
  // Unidade em que o produto é vendido e controlado no estoque.
  unidadeId      Int
  unidade        Unidade    @relation(fields: [unidadeId], references: [id])
  // Custo por unidade de venda (centavos).
  custo          Int        @default(0)
  // Preço de venda por unidade de venda (centavos).
  precoVenda     Int        @default(0)
  // Margem desejada (pontos-base). Nulo = herda da categoria ou da loja.
  margemPct      Int?
  estoqueMinimo  Int        @default(0) // milésimos
  // Saldo atual (milésimos). É um cache: a verdade são as movimentações,
  // e ele é atualizado na MESMA transação de cada movimentação.
  estoqueAtual   Int        @default(0)
  localizacao    String?
  observacoes    String?
  ativo          Boolean    @default(true)
  criadoEm       DateTime   @default(now())
  atualizadoEm   DateTime   @updatedAt

  conversoes    ProdutoConversao[]
  fornecedores  ProdutoFornecedor[]
  historicoPrecos HistoricoPreco[]
  movimentacoes MovimentacaoEstoque[]
  itensEntrada  EntradaItem[]
  itensVenda    VendaItem[]

  @@index([descricaoBusca])
  @@index([categoriaId])
}

/// Unidade de compra: 1 CX = 2,5 M2 → unidadeId = CX, fator = 2500 (milésimos da unidade de venda).
model ProdutoConversao {
  id        Int     @id @default(autoincrement())
  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  unidadeId Int
  unidade   Unidade @relation(fields: [unidadeId], references: [id])
  fator     Int

  @@unique([produtoId, unidadeId])
}

model ProdutoFornecedor {
  produtoId        Int
  produto          Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedorId     Int
  fornecedor       Fornecedor @relation(fields: [fornecedorId], references: [id])
  codigoFornecedor String?

  @@id([produtoId, fornecedorId])
  @@index([fornecedorId])
}

model HistoricoPreco {
  id             Int      @id @default(autoincrement())
  produtoId      Int
  produto        Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  custoAnterior  Int
  custoNovo      Int
  precoAnterior  Int
  precoNovo      Int
  motivo         String
  usuarioId      Int?
  usuario        Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm       DateTime @default(now())

  @@index([produtoId, criadoEm])
}

// ---------------------------------------------------------------- Etapa 3

enum TipoMovimentacao {
  ENTRADA_COMPRA
  ESTORNO_COMPRA
  AJUSTE_ENTRADA
  AJUSTE_SAIDA
  PERDA
  INVENTARIO
  VENDA
  ESTORNO_VENDA
}

/// Livro de movimentações: o estoque nunca é editado direto.
model MovimentacaoEstoque {
  id            Int              @id @default(autoincrement())
  produtoId     Int
  produto       Produto          @relation(fields: [produtoId], references: [id])
  tipo          TipoMovimentacao
  quantidade    Int              // milésimos; positivo entra, negativo sai
  saldoApos     Int              // milésimos
  custoUnitario Int              // centavos por unidade de venda, no momento
  motivo        String?
  entradaId     Int?
  entrada       Entrada?         @relation(fields: [entradaId], references: [id])
  vendaId       Int?
  venda         Venda?           @relation(fields: [vendaId], references: [id])
  usuarioId     Int?
  usuario       Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm      DateTime         @default(now())

  @@index([produtoId, id])
  @@index([criadoEm])
  @@index([entradaId])
}

enum StatusEntrada {
  FINALIZADA
  CANCELADA
}

/// Entrada de mercadoria (compra / nota do fornecedor).
model Entrada {
  id                 Int           @id @default(autoincrement())
  fornecedorId       Int?
  fornecedor         Fornecedor?   @relation(fields: [fornecedorId], references: [id])
  numeroNota         String?
  dataEmissao        DateTime?
  // Centavos. Rateados entre os itens proporcionalmente ao valor de cada um.
  frete              Int           @default(0)
  outrasDespesas     Int           @default(0)
  desconto           Int           @default(0)
  totalProdutos      Int
  totalNota          Int
  observacoes        String?
  status             StatusEntrada @default(FINALIZADA)
  usuarioId          Int?
  usuario            Usuario?      @relation("EntradaCriadaPor", fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm           DateTime      @default(now())
  canceladaEm        DateTime?
  canceladaPorId     Int?
  canceladaPor       Usuario?      @relation("EntradaCanceladaPor", fields: [canceladaPorId], references: [id], onDelete: SetNull)
  motivoCancelamento String?

  itens         EntradaItem[]
  movimentacoes MovimentacaoEstoque[]

  @@index([criadoEm])
  @@index([fornecedorId])
}

model EntradaItem {
  id                Int     @id @default(autoincrement())
  entradaId         Int
  entrada           Entrada @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  produtoId         Int
  produto           Produto @relation(fields: [produtoId], references: [id])
  // Como veio na nota (ex.: 10 CX a R$ 75,00)
  unidadeId         Int
  unidade           Unidade @relation(fields: [unidadeId], references: [id])
  fator             Int     // milésimos da unidade de venda por 1 unidade de compra (1000 = mesma unidade)
  quantidade        Int     // milésimos, na unidade de compra
  custoUnitario     Int     // centavos por unidade de compra
  // Convertido para a unidade de venda, já com frete/despesas/desconto rateados
  quantidadeEstoque Int     // milésimos
  custoTotal        Int     // centavos (valor do item + rateio)
  custoMedioAntes   Int
  custoMedioDepois  Int
}

// ---------------------------------------------------------------- Etapa 4

model Cliente {
  id           Int      @id @default(autoincrement())
  nome         String
  nomeBusca    String
  documento    String?  @unique // CPF ou CNPJ, só dígitos/letras
  telefone     String?
  email        String?
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  uf           String?
  observacoes  String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  vendas  Venda[]
  boletos ContaReceber[]

  @@index([nomeBusca])
}

enum FormaPagamento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  BOLETO
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

/// Sessão de caixa: do momento em que o operador abre até o fechamento com conferência.
model CaixaSessao {
  id          Int         @id @default(autoincrement())
  usuarioId   Int
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  status      StatusCaixa @default(ABERTO)
  fundoTroco  Int         // centavos
  abertoEm    DateTime    @default(now())
  fechadoEm   DateTime?
  observacao  String?

  movimentos  CaixaMovimento[]
  fechamento  CaixaFechamento[]
  vendas      Venda[]

  @@index([usuarioId, status])
  @@index([abertoEm])
}

enum TipoMovimentoCaixa {
  VENDA
  ESTORNO_VENDA
  SANGRIA
  SUPRIMENTO
}

model CaixaMovimento {
  id        Int                @id @default(autoincrement())
  sessaoId  Int
  sessao    CaixaSessao        @relation(fields: [sessaoId], references: [id])
  tipo      TipoMovimentoCaixa
  forma     FormaPagamento
  valor     Int                // centavos; positivo entra, negativo sai
  motivo    String?
  vendaId   Int?
  venda     Venda?             @relation(fields: [vendaId], references: [id])
  usuarioId Int?
  usuario   Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  criadoEm  DateTime           @default(now())

  @@index([sessaoId])
}

/// Conferência do fechamento, por forma de pagamento.
model CaixaFechamento {
  id        Int            @id @default(autoincrement())
  sessaoId  Int
  sessao    CaixaSessao    @relation(fields: [sessaoId], references: [id])
  forma     FormaPagamento
  esperado  Int
  informado Int
  diferenca Int

  @@unique([sessaoId, forma])
}

enum StatusVenda {
  ORCAMENTO
  CONVERTIDO // orçamento que virou venda
  FINALIZADA
  CANCELADA
}

model Venda {
  id                 Int         @id @default(autoincrement())
  status             StatusVenda
  clienteId          Int?
  cliente            Cliente?    @relation(fields: [clienteId], references: [id])
  vendedorId         Int
  vendedor           Usuario     @relation("VendaVendedor", fields: [vendedorId], references: [id])
  caixaSessaoId      Int?
  caixaSessao        CaixaSessao? @relation(fields: [caixaSessaoId], references: [id])
  orcamentoOrigemId  Int?        @unique
  orcamentoOrigem    Venda?      @relation("OrcamentoVenda", fields: [orcamentoOrigemId], references: [id])
  vendaGerada        Venda?      @relation("OrcamentoVenda")
  subtotal           Int         // soma de quantidade × preço, sem desconto
  descontoItens      Int         @default(0)
  descontoGeral      Int         @default(0)
  total              Int
  troco              Int         @default(0)
  validoAte          DateTime?   // orçamentos
  observacoes        String?
  // Autorização do gerente (desconto acima do limite / venda sem estoque)
  autorizadoPorId    Int?
  autorizadoPor      Usuario?    @relation("VendaAutorizadaPor", fields: [autorizadoPorId], references: [id], onDelete: SetNull)
  motivosAutorizacao String?
  criadoEm           DateTime    @default(now())
  finalizadaEm       DateTime?
  canceladaEm        DateTime?
  canceladaPorId     Int?
  canceladaPor       Usuario?    @relation("VendaCanceladaPor", fields: [canceladaPorId], references: [id], onDelete: SetNull)
  motivoCancelamento String?
  cancelamentoAutorizadoPorId Int?

  itens         VendaItem[]
  pagamentos    VendaPagamento[]
  boletos       ContaReceber[]
  movimentosCaixa CaixaMovimento[]
  movimentacoesEstoque MovimentacaoEstoque[]

  @@index([status, criadoEm])
  @@index([finalizadaEm])
  @@index([vendedorId])
  @@index([clienteId])
}

model VendaItem {
  id            Int     @id @default(autoincrement())
  vendaId       Int
  venda         Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId     Int
  produto       Produto @relation(fields: [produtoId], references: [id])
  descricao     String  // cópia no momento da venda
  unidadeSigla  String
  quantidade    Int     // milésimos
  precoUnitario Int     // centavos
  desconto      Int     @default(0) // centavos, na linha
  total         Int     // quantidade × preço − desconto
  // Custo médio no momento da venda: o relatório de margem fica certo mesmo se o custo mudar depois.
  custoUnitario Int
}

model VendaPagamento {
  id       Int            @id @default(autoincrement())
  vendaId  Int
  venda    Venda          @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  forma    FormaPagamento
  valor    Int            // centavos (no dinheiro, já descontado o troco)
  parcelas Int            @default(1)
}

enum StatusContaReceber {
  ABERTO
  PAGO
  CANCELADO
}

/// Parcelas de boleto a receber.
model ContaReceber {
  id           Int                @id @default(autoincrement())
  vendaId      Int
  venda        Venda              @relation(fields: [vendaId], references: [id])
  clienteId    Int
  cliente      Cliente            @relation(fields: [clienteId], references: [id])
  parcela      Int
  totalParcelas Int
  valor        Int
  vencimento   DateTime
  status       StatusContaReceber @default(ABERTO)
  pagoEm       DateTime?
  valorPago    Int?
  baixadoPorId Int?
  baixadoPor   Usuario?           @relation(fields: [baixadoPorId], references: [id], onDelete: SetNull)
  criadoEm     DateTime           @default(now())

  @@index([status, vencimento])
  @@index([clienteId])
}
